# ==============================================================================
# MARQUE SUA HORA — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================

# AMBIENTE & PORTAS
NODE_ENV=production
API_PORT=3333
WEB_PORT=3000
API_URL=https://api.marquesuahora.com.br
NEXT_PUBLIC_API_URL=https://api.marquesuahora.com.br
NEXT_PUBLIC_APP_URL=https://marquesuahora.com.br

# BANCO DE DADOS (POSTGRESQL 16)
POSTGRES_USER=marquesuahora
POSTGRES_PASSWORD=sua_senha_segura_postgres_aqui
POSTGRES_DB=marquesuahora_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://marquesuahora:sua_senha_segura_postgres_aqui@postgres:5432/marquesuahora_db?schema=public"

# CACHE & FILAS BULLMQ (REDIS 7)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=sua_senha_segura_redis_aqui
REDIS_URL="redis://:sua_senha_segura_redis_aqui@redis:6379"

# SEGURANÇA & CRIPTOGRAFIA (Gere via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=seu_jwt_secret_64_bytes_hex
JWT_REFRESH_SECRET=seu_jwt_refresh_secret_64_bytes_hex
SESSION_SECRET=seu_session_secret_64_bytes_hex

# WHATSAPP (EVOLUTION API V2.3.6)
# URL interna no Docker: http://evolution:8080 ou URL pública da sua VPS: http://IP_OU_DOMINIO:8080
EVOLUTION_PORT=8080
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_GLOBAL_KEY=sua_chave_mestra_evolution_api_aqui

# INTELIGÊNCIA ARTIFICIAL (IA HÍBRIDA: TYPESAFE JEV + OPENROUTER)
# 1. TypeSafe Jev (System One): Roda localmente em TypeScript (<1ms, R$ 0,00). NÃO precisa de chave externa!
# 2. OpenRouter (System Two LLM): Atendente virtual para tirar dúvidas abertas sobre serviços e tabela do salão.
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-sua_chave_openrouter_aqui
# Modelos recomendados de alta velocidade e custo insignificante:
# - google/gemini-2.0-flash-001 (Rápido, inteligente e baratíssimo)
# - meta-llama/llama-3.3-70b-instruct
# - anthropic/claude-3.5-haiku
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# GATEWAY DE PAGAMENTOS (ASAAS)
# Produção: https://api.asaas.com/v3 | Sandbox: https://sandbox.asaas.com/api/v3
ASAAS_API_URL="https://api.asaas.com/v3"
ASAAS_API_KEY=sua_chave_api_asaas_aqui
ASAAS_WEBHOOK_SECRET=seu_token_webhook_asaas_aqui

# E-MAIL TRANSACIONAL (RESEND)
# Obtenha sua chave de API em: https://resend.com/api-keys
# Domínio verificado no Resend: marquesuahora.com.br
RESEND_API_KEY=re_sua_chave_resend_aqui
RESEND_WEBHOOK_SECRET=whsec_seu_segredo_webhook_resend_aqui
EMAIL_FROM="Marque Sua Hora <notificacoes@marquesuahora.com.br>"


