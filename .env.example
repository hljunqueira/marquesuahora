# ==============================================================================
# MARQUE SUA HORA — VARIÁVEIS DE AMBIENTE (MODELO .env.example)
# ==============================================================================

# AMBIENTE & PORTAS
NODE_ENV=development
API_PORT=3333
WEB_PORT=3000
API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
NEXT_PUBLIC_APP_URL=http://localhost:3000

# BANCO DE DADOS (POSTGRESQL 16)
POSTGRES_USER=marquesuahora
POSTGRES_PASSWORD=sua_senha_segura_postgres
POSTGRES_DB=marquesuahora_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://marquesuahora:sua_senha_segura_postgres@localhost:5432/marquesuahora_db?schema=public"

# CACHE & FILAS (REDIS 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=sua_senha_segura_redis
REDIS_URL="redis://:sua_senha_segura_redis@localhost:6379"

# SEGURANÇA & CRIPTOGRAFIA (GERADAS VIA NODE CRYPTO: crypto.randomBytes(64).toString('hex'))
JWT_SECRET=seu_jwt_secret_64_bytes_hex
JWT_REFRESH_SECRET=seu_jwt_refresh_secret_64_bytes_hex
SESSION_SECRET=seu_session_secret_64_bytes_hex

# WHATSAPP (EVOLUTION API V2)
EVOLUTION_API_URL=http://46.202.144.181:8080
EVOLUTION_API_KEY=sua_chave_evolution_api

# INTELIGÊNCIA ARTIFICIAL (GEMINI 1.5 FLASH)
GEMINI_API_KEY=sua_chave_gemini_api

# GATEWAY DE PAGAMENTOS (ASAAS)
ASAAS_API_URL="https://sandbox.asaas.com/api/v3"
ASAAS_API_KEY=sua_chave_asaas
ASAAS_WEBHOOK_SECRET=seu_webhook_secret_asaas
